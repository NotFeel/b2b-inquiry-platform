{
  "name": "@b2b/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "acceptance:file-delete": "tsx scripts/file-delete-retry-acceptance.ts",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@b2b/contracts": "workspace:*",
    "@b2b/database": "workspace:*",
    "bullmq": "5.81.5",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.8",
    "exceljs": "4.4.0",
    "ioredis": "5.11.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@b2b/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
