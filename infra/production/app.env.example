# Copy to /opt/b2b-inquiry-platform/.env.api and chmod 600.
NODE_ENV=production
API_PORT=3002
APP_BASE_URL=https://wuxuanglobal.com
ADMIN_BASE_URL=https://admin.wuxuanglobal.com
API_BASE_URL=http://api:3002
ADMIN_API_PROXY_TARGET=http://api:3002
STOREFRONT_API_PROXY_TARGET=http://api:3002
ADMIN_ALLOWED_ORIGINS=https://admin.wuxuanglobal.com
LOG_LEVEL=info
LOG_PRETTY=false
TRUST_PROXY=true
SITE_TIMEZONE=UTC
DATABASE_URL=postgresql://b2b_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/b2b_catalog?schema=public
DIRECT_DATABASE_URL=postgresql://b2b_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/b2b_catalog?schema=public
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
SESSION_COOKIE_NAME=b2b_admin_session
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/uploads
GEOIP_PROVIDER=none
GEOIP_DATABASE_PATH=/data/geoip/GeoLite2-Country.mmdb
ANALYTICS_SALT=REPLACE_WITH_ANOTHER_RANDOM_SECRET
ANALYTICS_ACTIVE_WINDOW_SECONDS=300
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_EVENTS_PER_MINUTE=120
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=50000000
IMAGE_DERIVATIVE_WIDTHS=320,640,1280
IMAGE_PROCESSING_TIMEOUT_SECONDS=20
IMAGE_PROCESSING_CONCURRENCY=1
IMAGE_WEBP_QUALITY=82
QUOTE_EXPORT_MAX_PRODUCTS=5000
EXCEL_PDF_ENABLED=false
EXCEL_PDF_MAX_UPLOAD_BYTES=209715200
EXCEL_PDF_CHUNK_BYTES=8388608
EXCEL_PDF_MAX_OUTPUT_BYTES=52428800
EXCEL_PDF_MAX_PAGES=200
EXCEL_PDF_TIMEOUT_MS=300000
EXCEL_PDF_RETENTION_DAYS=7
EXCEL_PDF_CONVERTER_PATH=/usr/bin/soffice
EXCEL_PDF_PDFINFO_PATH=/usr/bin/pdfinfo
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=30
TASK_RUNNER_ID=production-worker-1
TASK_LEASE_SECONDS=120
TASK_POLL_INTERVAL_MS=2000
TASK_RETRY_BASE_DELAY_MS=3000
WORKER_TMP_DIR=/data/tmp
WHATSAPP_MAX_SELECTED_SKUS=20
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
