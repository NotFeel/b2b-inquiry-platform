# Copy to /opt/b2b-inquiry-platform/deploy/.env and chmod 600.
IMAGE_TAG=sha-REPLACE_WITH_40_CHAR_COMMIT_SHA
POSTGRES_DB=b2b_catalog
POSTGRES_USER=b2b_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://b2b_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/b2b_catalog?schema=public
DIRECT_DATABASE_URL=postgresql://b2b_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/b2b_catalog?schema=public
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN
GHCR_USERNAME=NotFeel
GHCR_READ_TOKEN=REPLACE_WITH_FINE_GRAINED_TOKEN_WITH_READ_PACKAGES
