  chunks ExcelPdfUploadChunk[]

  @@index([actorId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("excel_pdf_uploads")
}

model ExcelPdfUploadChunk {
  uploadId  String   @db.Uuid
