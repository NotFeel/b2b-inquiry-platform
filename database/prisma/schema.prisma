model PdfConversionJob {
  id              String    @id @default(uuid()) @db.Uuid
  sourceAssetId   String    @db.Uuid
  /// Set for chunked uploads introduced by docs/38. Kept nullable so legacy
  /// conversion rows remain valid without a destructive backfill.
  uploadId        String?   @unique @db.Uuid
  outputAssetId   String?   @unique @db.Uuid
  sourceFileName  String    @db.VarChar(255)
  sheetName       String?   @db.VarChar(120)
  businessType    String    @default("other") @db.VarChar(32)
  options         Json?
  status          JobStatus @default(QUEUED)
  attempts        Int       @default(0)
  attemptId       String?   @db.Uuid
  /// Conversion-attempt lease. A second worker may reclaim a PROCESSING job
  /// only after the lease expires; writes must match both attemptId and owner.
  leaseOwner      String?   @db.VarChar(120)
  leaseUntil      DateTime? @db.Timestamptz(6)
  inputSizeBytes  BigInt?
  inputSha256     String?   @db.VarChar(64)
  outputKey       String?   @db.VarChar(500)
  outputSizeBytes BigInt?
  outputSha256    String?   @db.VarChar(64)
  pageCount       Int?
  errorCode       String?   @db.VarChar(100)
  errorMessageKey String?   @db.VarChar(160)
  purgeState      PurgeState @default(NONE)
  purgeRequestedAt DateTime? @db.Timestamptz(6)
  startedAt       DateTime? @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)
  expiresAt       DateTime? @db.Timestamptz(6)
  requestedById   String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  sourceAsset FileAsset  @relation("PdfSourceAsset", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  outputAsset FileAsset? @relation("PdfOutputAsset", fields: [outputAssetId], references: [id], onDelete: SetNull)
  requestedBy AdminUser? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([status, leaseUntil])
  @@index([requestedById, createdAt(sort: Desc)])
  @@index([expiresAt, purgeState])
  @@map("pdf_conversion_jobs")
}

