  @@map("excel_pdf_upload_chunks")
}

// Object storage and the database have no shared transaction. Deleting produced
// files therefore goes through an idempotent, retryable job (docs/04, docs/10).
model FileDeletionJob {
  id             String    @id @default(uuid()) @db.Uuid
  /// Object-storage key to remove. Null only for aggregate tasks (for example
  /// the final `product` purge that runs after every image object is gone).
  storageKey     String?   @db.VarChar(500)
  /// `file_asset` | `quote_template` | `quote_export_job` | `pdf_conversion_job`
  /// | `product_image` | `product_import_chunk` | `product`
  /// | `commercial_document`. Never a client-supplied value.
  entityType     String?   @db.VarChar(100)
  entityId       String?   @db.VarChar(120)
  /// Owning product of the deleted object, so a product purge can wait for all
  /// of its image tasks without guessing keys (docs/24 §8.2).
  productId      String?   @db.Uuid
  requestedBy    String?   @db.Uuid
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now()) @db.Timestamptz(6)
  lockedBy       String?   @db.VarChar(120)
  lockedUntil    DateTime? @db.Timestamptz(6)
  heartbeatAt    DateTime? @db.Timestamptz(6)
  lastErrorCode  String?   @db.VarChar(120)
  /// Deduplicates re-submitted deletes for the same object, so a double click
  /// or a retried request cannot queue the same physical delete twice.
  idempotencyKey String?   @unique @db.VarChar(160)
  completedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, runAfter, lockedUntil])
  @@index([storageKey])
  @@index([entityType, entityId])
  @@index([productId, status])
  @@map("file_deletion_jobs")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventType      String    @db.VarChar(120)
  payload        Json
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now()) @db.Timestamptz(6)
  lockedBy       String?   @db.VarChar(120)
  lockedUntil    DateTime? @db.Timestamptz(6)
  heartbeatAt    DateTime? @db.Timestamptz(6)
  lastErrorCode  String?   @db.VarChar(120)
  idempotencyKey String?   @unique @db.VarChar(160)
  completedAt    DateTime? @db.Timestamptz(6)
  processedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, runAfter, lockedUntil])
  @@map("outbox_events")
}

