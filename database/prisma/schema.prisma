// Data model for the B2B catalogue / inquiry platform.
//
// Rules enforced here (docs/04):
// - UUID primary keys, stable business codes with their own unique keys.
// - UTC timestamps via Timestamptz, money as NUMERIC/Decimal only.
// - Translatable text lives in `*_translations` child tables keyed by locale.
// - Prices live only on internal entities and are never projected publicly.

generator client {
  provider = "prisma-client-js"
  // Explicit output keeps the generated client deterministic in the pnpm
  // workspace: consumers import it through the `@b2b/database` package.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum ProductLifecycleStatus {
  AVAILABLE
  PREORDER
  DISCONTINUED
}

enum QuotationStatus {
  DRAFT
  CONVERTED
  EXPIRED
  ARCHIVED
}

enum OrderStatus {
  CONFIRMED
  CANCELLED
}

enum CommercialDocumentType {
  PI
  CI
}

enum CommercialDocumentStatus {
  DRAFT
  REVIEW
  ISSUED
  SUPERSEDED
  CANCELLED
}

enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum DocumentTemplateVersionStatus {
  DRAFT
  PUBLISHED
}

enum FreightBillingMethod {
  CBM
  KG
}

enum KgChargeableBasis {
  VOLUME_WEIGHT
  GROSS_WEIGHT
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

// Tracks the DB <-> object storage consistency of a produced artefact.
enum PurgeState {
  NONE
  PENDING
  PURGED
  FAILED
}

model AdminUser {
  id                 String      @id @default(uuid()) @db.Uuid
  username           String      @unique @db.VarChar(80)
  displayName        String      @db.VarChar(120)
  passwordHash       String      @db.VarChar(255)
  status             AdminStatus @default(ACTIVE)
  mustChangePassword Boolean     @default(true)
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?   @db.Timestamptz(6)
  lastLoginAt        DateTime?   @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)

  userRoles                  UserRole[]
  sessions                   AdminSession[]
  auditLogs                  AuditLog[]
  createdProducts            Product[]                 @relation("ProductCreatedBy")
  uploadedFiles              FileAsset[]
  quoteExports               QuoteExportJob[]
  quoteTemplates             QuoteTemplate[]
  pdfConversions             PdfConversionJob[]
  excelPdfUploads            ExcelPdfUpload[]
  piDocuments                PiDocument[]
  quotationsCreated          Quotation[]               @relation("QuotationCreator")
  quotationRatesSet          Quotation[]               @relation("QuotationRateEditor")
  ordersCreated              Order[]                   @relation("OrderCreator")
  commercialDocumentsCreated CommercialDocument[]      @relation("CommercialDocumentCreator")
  commercialDocumentsIssued  CommercialDocument[]      @relation("CommercialDocumentIssuer")
  documentTemplatesCreated   DocumentTemplate[]        @relation("DocumentTemplateCreator")
  documentTemplatesUpdated   DocumentTemplate[]        @relation("DocumentTemplateUpdater")
  documentTemplateVersions   DocumentTemplateVersion[] @relation("DocumentTemplateVersionCreator")
  commercialDocumentRenders  DocumentRenderJob[]       @relation("CommercialDocumentRenderRequester")
  inquiryActivities          InquiryActivity[]         @relation("InquirySalespersonUser")
  factoryMedia               FactoryMedia[]            @relation("FactoryMediaCreatedBy")
  factoryProcessSteps        FactoryProcessStep[]      @relation("FactoryProcessStepCreatedBy")
  credentials                Credential[]              @relation("CredentialCreatedBy")
  // Import validation tokens are short-lived and cascade with their owner.
  productImportValidations   ProductImportValidation[]
  productImportUploads       ProductImportUpload[]

  @@index([status, username])
  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  userAgent String?   @db.VarChar(255)
  ipHash    String?   @db.VarChar(128)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("admin_sessions")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(80)
  nameKey     String  @db.VarChar(160)
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  userRoles    UserRole[]
  permissions  RolePermission[]
  translations RoleTranslation[]

  @@map("roles")
}

/// Administrator-maintained role names (docs/18 §2.4, §3.3).
///
/// Seeded roles keep resolving through `Role.nameKey` plus the i18n dictionary;
/// custom roles created in the back office store their display names here, so
/// `nameKey` is never repurposed as free-form display text.
model RoleTranslation {
  roleId      String  @db.Uuid
  locale      String  @db.VarChar(16)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(500)
  role        Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, locale])
  @@map("role_translations")
}

model Permission {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique @db.VarChar(120)
  nameKey String @db.VarChar(180)
  module  String @db.VarChar(80)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId String    @db.Uuid
  roleId String    @db.Uuid
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId         String     @db.Uuid
  permissionCode String     @db.VarChar(120)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

model Menu {
  id             String  @id @default(uuid()) @db.Uuid
  code           String  @unique @db.VarChar(100)
  parentId       String? @db.Uuid
  route          String? @db.VarChar(240)
  icon           String? @db.VarChar(60)
  permissionCode String? @db.VarChar(120)
  sortOrder      Int     @default(0)
  visible        Boolean @default(true)
  enabled        Boolean @default(true)
  external       Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  parent       Menu?             @relation("MenuTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Menu[]            @relation("MenuTree")
  translations MenuTranslation[]

  @@index([parentId, sortOrder])
  @@map("menus")
}

model MenuTranslation {
  menuId String @db.Uuid
  locale String @db.VarChar(16)
  label  String @db.VarChar(160)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([menuId, locale])
  @@map("menu_translations")
}

model DictionaryType {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(100)
  nameKey      String  @db.VarChar(180)
  description  String?
  systemLocked Boolean @default(false)
  enabled      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items DictionaryItem[]

  @@map("dictionary_types")
}

model DictionaryItem {
  id           String  @id @default(uuid()) @db.Uuid
  typeId       String  @db.Uuid
  code         String  @db.VarChar(100)
  value        String? @db.VarChar(240)
  sortOrder    Int     @default(0)
  enabled      Boolean @default(true)
  systemLocked Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  type         DictionaryType              @relation(fields: [typeId], references: [id], onDelete: Cascade)
  translations DictionaryItemTranslation[]

  productsAsLifecycleStatus  Product[]   @relation("ProductLifecycleStatusItem")
  productsAsPublishStatus    Product[]   @relation("ProductPublishStatusItem")
  quotationsAsFreightDivisor Quotation[] @relation("QuotationFreightDivisor")
  ordersAsFreightDivisor     Order[]     @relation("OrderFreightDivisor")

  @@unique([typeId, code])
  @@index([typeId, enabled, sortOrder])
  @@map("dictionary_items")
}

model DictionaryItemTranslation {
  itemId String         @db.Uuid
  locale String         @db.VarChar(16)
  label  String         @db.VarChar(160)
  item   DictionaryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, locale])
  @@map("dictionary_item_translations")
}

model GlobalSetting {
  key      String  @id @db.VarChar(160)
  value    Json
  isPublic Boolean @default(false)
  isSecret Boolean @default(false)

  // Metadata added by the settings rework (docs/21 §5.2). Every field has a
  // default so the migration is additive and no existing key/value is touched.
  groupCode      String  @default("custom") @db.VarChar(60)
  valueType      String  @default("string") @db.VarChar(30)
  labelKey       String? @db.VarChar(180)
  descriptionKey String? @db.VarChar(180)
  isSystem       Boolean @default(false)
  isEditable     Boolean @default(true)
  isDeletable    Boolean @default(true)
  isRequired     Boolean @default(false)
  sortOrder      Int     @default(0)
  validation     Json?
  options        Json?
  revision       Int     @default(1)

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  translations GlobalSettingTranslation[]

  @@index([isPublic])
  @@index([groupCode, sortOrder])
  @@map("global_settings")
}

/// Administrator-maintained names for custom settings (docs/21 §5.2).
///
/// Built-in settings resolve their label from `labelKey` + the i18n dictionary
/// instead, so there is never two sources of truth for the same string.
model GlobalSettingTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  settingKey  String        @db.VarChar(160)
  locale      String        @db.VarChar(16)
  label       String        @db.VarChar(180)
  description String?
  setting     GlobalSetting @relation(fields: [settingKey], references: [key], onDelete: Cascade)

  @@unique([settingKey, locale])
  @@index([locale])
  @@map("global_setting_translations")
}

model Category {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique @db.VarChar(100)
  slug             String  @unique @db.VarChar(180)
  parentId         String? @db.Uuid
  coverFileAssetId String? @db.Uuid
  sortOrder        Int     @default(0)
  enabled          Boolean @default(true)
  visible          Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  parent              Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[]            @relation("CategoryTree")
  cover               FileAsset?            @relation("CategoryCover", fields: [coverFileAssetId], references: [id], onDelete: SetNull)
  translations        CategoryTranslation[]
  products            Product[]
  homepageCollections HomepageCollection[]

  @@index([parentId, sortOrder])
  @@index([enabled, visible])
  @@map("categories")
}

model CategoryTranslation {
  categoryId  String   @db.Uuid
  locale      String   @db.VarChar(16)
  name        String   @db.VarChar(240)
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id              String                 @id @default(uuid()) @db.Uuid
  sku             String                 @unique @db.VarChar(64)
  slug            String                 @unique @db.VarChar(180)
  categoryId      String?                @db.Uuid
  priceCny        Decimal?               @db.Decimal(18, 4)
  lifecycleStatus ProductLifecycleStatus @default(AVAILABLE)
  publishStatus   PublishStatus          @default(DRAFT)

  // Stage 1 of the enum → dictionary migration (docs/20 §8): expand + backfill.
  // The enum columns stay authoritative for reads until the separate switch
  // release, so both must remain in parity; the contract release adds NOT NULL.
  lifecycleStatusItemId String? @db.Uuid
  publishStatusItemId   String? @db.Uuid

  isNew      Boolean @default(false)
  isFeatured Boolean @default(false)
  /// Home-page curation: show this product in the storefront pre-order rail.
  ///
  /// Distinct from `lifecycleStatus`: the lifecycle says the product *is* a
  /// pre-order item (business state, drives the catalogue badge and filters),
  /// while this flag says the operator *wants it on the home page*. It can only
  /// be true for a `PREORDER` product; every other lifecycle forces it to false
  /// (enforced in the service, backfilled by the migration).
  isPreOrder Boolean @default(false)
  sortOrder  Int     @default(0)

  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  weightGrams    Int?
  packaging      String?  @db.VarChar(500)
  cartonLengthCm Decimal? @db.Decimal(12, 3)
  cartonWidthCm  Decimal? @db.Decimal(12, 3)
  cartonHeightCm Decimal? @db.Decimal(12, 3)
  cartonWeightKg Decimal? @db.Decimal(12, 3)
  cartonQuantity Int?

  /// Export/customs attributes. Copied into order/document snapshots so later
  /// master-data changes never rewrite history (docs/41 §6.3).
  hsCode             String?  @db.VarChar(20)
  originCountryCode  String?  @db.VarChar(2)
  customsDescription String?
  netWeightPerUnitKg Decimal? @db.Decimal(18, 6)
  exportUnit         String?  @db.VarChar(24)

  createdById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  category                Category?                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy               AdminUser?                  @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lifecycleStatusItem     DictionaryItem?             @relation("ProductLifecycleStatusItem", fields: [lifecycleStatusItemId], references: [id], onDelete: Restrict)
  publishStatusItem       DictionaryItem?             @relation("ProductPublishStatusItem", fields: [publishStatusItemId], references: [id], onDelete: Restrict)
  translations            ProductTranslation[]
  images                  ProductImage[]
  tags                    ProductTag[]
  quotationItems          QuotationItem[]
  orderItems              OrderItem[]
  homepageCollectionItems HomepageCollectionProduct[]

  @@index([categoryId, publishStatus, lifecycleStatus])
  @@index([publishStatus, isFeatured, sortOrder])
  @@index([publishStatus, isNew, sortOrder])
  @@index([publishStatus, isPreOrder, sortOrder])
  @@index([publishStatus, lifecycleStatus, sortOrder])
  @@index([lifecycleStatusItemId])
  @@index([publishStatusItemId])
  @@map("products")
}

model ProductTranslation {
  productId      String  @db.Uuid
  locale         String  @db.VarChar(16)
  name           String  @db.VarChar(240)
  description    String?
  seoTitle       String? @db.VarChar(240)
  seoDescription String? @db.VarChar(400)
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@map("product_translations")
}

model Tag {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique @db.VarChar(80)
  colorToken String? @db.VarChar(60)
  enabled    Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  translations TagTranslation[]
  products     ProductTag[]

  @@map("tags")
}

model TagTranslation {
  tagId  String @db.Uuid
  locale String @db.VarChar(16)
  label  String @db.VarChar(100)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, locale])
  @@map("tag_translations")
}

model ProductTag {
  productId String  @db.Uuid
  tagId     String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a tag must never silently drop the product
  // associations attached to it. The service refuses the delete with TAG_IN_USE;
  // this constraint is the second line of defence (docs/23 §6.5).
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  fileAssetId String?  @db.Uuid
  storageKey  String   @db.VarChar(500)
  altText     String?  @db.VarChar(240)
  sortOrder   Int      @default(0)
  isCover     Boolean  @default(false)
  width       Int?
  height      Int?
  sizeBytes   BigInt?
  sha256      String?  @db.VarChar(64)
  /// Physical-deletion state of this image (docs/24 §4.4, §8.2).
  ///
  /// `READY`          - usable and publicly visible.
  /// `DELETE_PENDING` - a permanent delete was requested; the object is being
  ///                    removed by the worker and the row must not be shown or
  ///                    used as a cover until the object is confirmed gone.
  /// `DELETE_FAILED`  - the object storage delete failed; the key and the task
  ///                    stay so an operator can retry instead of losing the
  ///                    only clue about an undeleted file.
  deleteState String   @default("READY") @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([productId, deleteState])
  @@map("product_images")
}

model FileAsset {
  id           String  @id @default(uuid()) @db.Uuid
  storageKey   String  @unique @db.VarChar(500)
  originalName String  @db.VarChar(255)
  mimeType     String  @db.VarChar(120)
  sizeBytes    BigInt
  sha256       String? @db.VarChar(64)
  width        Int?
  height       Int?
  purpose      String  @db.VarChar(40)
  status       String  @default("processing") @db.VarChar(32)
  isPublic     Boolean @default(false)
  derivatives  Json?
  uploadedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  uploadedBy              AdminUser?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productImages           ProductImage[]
  categoryCovers          Category[]           @relation("CategoryCover")
  adDesktopFor            Ad[]                 @relation("AdDesktopAsset")
  adMobileFor             Ad[]                 @relation("AdMobileAsset")
  pdfSources              PdfConversionJob[]   @relation("PdfSourceAsset")
  pdfOutputs              PdfConversionJob[]   @relation("PdfOutputAsset")
  factoryMediaAssets      FactoryMedia[]       @relation("FactoryMediaAsset")
  factoryMediaCovers      FactoryMedia[]       @relation("FactoryMediaCover")
  factoryProcessAssets    FactoryProcessStep[] @relation("FactoryProcessAsset")
  credentialPrimaryAssets Credential[]         @relation("CredentialPrimaryAsset")

  @@index([status, createdAt])
  @@index([purpose, createdAt])
  @@map("file_assets")
}

model Ad {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(100)
  placement      String    @db.VarChar(100)
  desktopAssetId String?   @db.Uuid
  mobileAssetId  String?   @db.Uuid
  targetUrl      String?   @db.VarChar(1000)
  activeFrom     DateTime? @db.Timestamptz(6)
  activeTo       DateTime? @db.Timestamptz(6)
  sortOrder      Int       @default(0)
  enabled        Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  desktopAsset FileAsset?      @relation("AdDesktopAsset", fields: [desktopAssetId], references: [id], onDelete: SetNull)
  mobileAsset  FileAsset?      @relation("AdMobileAsset", fields: [mobileAssetId], references: [id], onDelete: SetNull)
  translations AdTranslation[]

  @@index([placement, enabled, activeFrom, activeTo])
  @@map("ads")
}

model AdTranslation {
  adId        String  @db.Uuid
  locale      String  @db.VarChar(16)
  title       String? @db.VarChar(240)
  description String?
  ad          Ad      @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([adId, locale])
  @@map("ad_translations")
}

model ContentPage {
  id        String        @id @default(uuid()) @db.Uuid
  slug      String        @unique @db.VarChar(180)
  pageType  String        @db.VarChar(40)
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  translations ContentPageTranslation[]

  @@index([status, sortOrder])
  @@map("content_pages")
}

model ContentPageTranslation {
  pageId         String      @db.Uuid
  locale         String      @db.VarChar(16)
  title          String      @db.VarChar(240)
  bodyHtml       String?
  seoTitle       String?     @db.VarChar(240)
  seoDescription String?     @db.VarChar(400)
  page           ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, locale])
  @@map("content_page_translations")
}

model FactoryMedia {
  id              String        @id @default(uuid()) @db.Uuid
  mediaType       String        @db.VarChar(20)
  assetId         String?       @db.Uuid
  coverAssetId    String?       @db.Uuid
  videoSourceType String?       @db.VarChar(20)
  videoUrl        String?       @db.VarChar(1000)
  sourceNote      String?
  adminNote       String?
  placements      String[]      @default([])
  sortOrder       Int           @default(0)
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?     @db.Timestamptz(6)
  createdById     String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  asset        FileAsset?                @relation("FactoryMediaAsset", fields: [assetId], references: [id], onDelete: Restrict)
  coverAsset   FileAsset?                @relation("FactoryMediaCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  createdBy    AdminUser?                @relation("FactoryMediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  translations FactoryMediaTranslation[]

  @@index([status, sortOrder])
  @@index([mediaType, status])
  @@map("factory_media")
}

model FactoryMediaTranslation {
  mediaId     String       @db.Uuid
  locale      String       @db.VarChar(16)
  title       String       @db.VarChar(240)
  description String?
  altText     String?      @db.VarChar(240)
  media       FactoryMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, locale])
  @@map("factory_media_translations")
}

model FactoryProcessStep {
  id          String        @id @default(uuid()) @db.Uuid
  assetId     String?       @db.Uuid
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(6)
  adminNote   String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  asset        FileAsset?                      @relation("FactoryProcessAsset", fields: [assetId], references: [id], onDelete: Restrict)
  createdBy    AdminUser?                      @relation("FactoryProcessStepCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  translations FactoryProcessStepTranslation[]

  @@index([status, sortOrder])
  @@map("factory_process_steps")
}

model FactoryProcessStepTranslation {
  stepId      String             @db.Uuid
  locale      String             @db.VarChar(16)
  title       String             @db.VarChar(240)
  description String?
  step        FactoryProcessStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([stepId, locale])
  @@map("factory_process_step_translations")
}

model Credential {
  id                 String        @id @default(uuid()) @db.Uuid
  credentialTypeCode String        @db.VarChar(100)
