/// Short-lived server-side result of a fully validated product workbook.
///
/// A commit consumes this row in the same transaction as every Product write,
/// so the same validation cannot create a duplicate batch even with multiple
/// API instances. Normalized rows are removed by expiry or first consumption.
model ProductImportValidation {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique @db.VarChar(64)
  actorId         String    @db.Uuid
  fileSha256      String    @db.VarChar(64)
  templateVersion String    @db.VarChar(32)
  configHash      String    @db.VarChar(64)
  payload         Json
  rowCount        Int
  imageCount      Int
  expiresAt       DateTime  @db.Timestamptz(6)
  consumedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  actor AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, expiresAt])
  @@index([expiresAt])
  @@map("product_import_validations")
}

/// Chunked, asynchronous import upload. The workbook binary lives only in
/// private object storage; this row tracks its owner, lifecycle and validation
/// outcome. ProductImportValidation remains the one-time commit capability.
model ProductImportUpload {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String    @db.Uuid
  status       String    @default("UPLOADING") @db.VarChar(32)
  originalName String    @db.VarChar(255)
  declaredSize BigInt
  chunkSize    Int
  chunkCount   Int
  settings     Json
  fileSha256   String?   @db.VarChar(64)
  summary      Json?
  errors       Json?
  warnings     Json?
  validationId String?   @db.Uuid
  errorCode    String?   @db.VarChar(120)
  expiresAt    DateTime  @db.Timestamptz(6)
  completedAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  actor  AdminUser            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  chunks ProductImportChunk[]

  @@index([actorId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("product_import_uploads")
}

model ProductImportChunk {
  uploadId  String   @db.Uuid
  index     Int
  sizeBytes BigInt
  sha256    String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  upload ProductImportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, index])
  @@map("product_import_chunks")
}

/// Chunked 200 MiB XLSX staging for Excel-to-PDF (docs/38). The chunks are
