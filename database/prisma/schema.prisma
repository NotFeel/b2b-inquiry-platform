/// Short-lived server-side result of a fully validated product workbook.
///
/// A commit consumes this row in the same transaction as every Product write,
/// so the same validation cannot create a duplicate batch even with multiple
/// API instances. Normalized rows are removed by expiry or first consumption.
model ProductImportValidation {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique @db.VarChar(64)
  actorId         String    @db.Uuid
  fileSha256      String    @db.VarChar(64)
  templateVersion String    @db.VarChar(32)
  configHash      String    @db.VarChar(64)
  payload         Json
  rowCount        Int
  imageCount      Int
  expiresAt       DateTime  @db.Timestamptz(6)
  consumedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  actor AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, expiresAt])
  @@index([expiresAt])
  @@map("product_import_validations")
}

/// Chunked, asynchronous import upload. The workbook binary lives only in
/// private object storage; this row tracks its owner, lifecycle and validation
/// outcome. ProductImportValidation remains the one-time commit capability.
model ProductImportUpload {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String    @db.Uuid
  status       String    @default("UPLOADING") @db.VarChar(32)
  originalName String    @db.VarChar(255)
  declaredSize BigInt
  chunkSize    Int
  chunkCount   Int
  settings     Json
  fileSha256   String?   @db.VarChar(64)
  summary      Json?
  errors       Json?
  warnings     Json?
  validationId String?   @db.Uuid
  errorCode    String?   @db.VarChar(120)
  expiresAt    DateTime  @db.Timestamptz(6)
  completedAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  actor  AdminUser            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  chunks ProductImportChunk[]

  @@index([actorId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("product_import_uploads")
}

model ProductImportChunk {
  uploadId String   @db.Uuid
  index    Int
  sizeBytes BigInt
  sha256   String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  upload ProductImportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, index])
  @@map("product_import_chunks")
}

/// Chunked 200 MiB XLSX staging for Excel-to-PDF (docs/38). The chunks are
/// private storage objects; completing this upload creates the durable job and
/// outbox event. The Worker is the only component that merges and validates the
/// complete OOXML package.
model ExcelPdfUpload {
  id             String    @id @default(uuid()) @db.Uuid
  actorId        String    @db.Uuid
  idempotencyKey String    @unique @db.VarChar(128)
  status         String    @default("UPLOADING") @db.VarChar(32)
  originalName   String    @db.VarChar(255)
  declaredSize   BigInt
  chunkSize      Int
  chunkCount     Int
  businessType   String    @default("other") @db.VarChar(32)
  options        Json
  jobId          String?   @unique @db.Uuid
  errorCode      String?   @db.VarChar(120)
  expiresAt      DateTime  @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  actor  AdminUser           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  chunks ExcelPdfUploadChunk[]

  @@index([actorId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("excel_pdf_uploads")
}

model ExcelPdfUploadChunk {
  uploadId  String   @db.Uuid
  index     Int
  sizeBytes BigInt
  sha256    String   @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  upload ExcelPdfUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, index])
  @@map("excel_pdf_upload_chunks")
}

// Object storage and the database have no shared transaction. Deleting produced
// files therefore goes through an idempotent, retryable job (docs/04, docs/10).
model FileDeletionJob {
  id             String    @id @default(uuid()) @db.Uuid
  /// Object-storage key to remove. Null only for aggregate tasks (for example
  /// the final `product` purge that runs after every image object is gone).
  storageKey     String?   @db.VarChar(500)
  /// `file_asset` | `quote_template` | `quote_export_job` | `pdf_conversion_job`
  /// | `product_image` | `product_import_chunk` | `product`. Never a client-supplied value.
  entityType     String?   @db.VarChar(100)
  entityId       String?   @db.VarChar(120)
  /// Owning product of the deleted object, so a product purge can wait for all
  /// of its image tasks without guessing keys (docs/24 §8.2).
  productId      String?   @db.Uuid
  requestedBy    String?   @db.Uuid
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now()) @db.Timestamptz(6)
  lockedBy       String?   @db.VarChar(120)
  lockedUntil    DateTime? @db.Timestamptz(6)
  heartbeatAt    DateTime? @db.Timestamptz(6)
  lastErrorCode  String?   @db.VarChar(120)
  /// Deduplicates re-submitted deletes for the same object, so a double click
  /// or a retried request cannot queue the same physical delete twice.
  idempotencyKey String?   @unique @db.VarChar(160)
  completedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, runAfter, lockedUntil])
  @@index([storageKey])
  @@index([entityType, entityId])
  @@index([productId, status])
  @@map("file_deletion_jobs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @db.VarChar(120)
  payload       Json
  status        JobStatus @default(QUEUED)
  attempts      Int       @default(0)
  runAfter      DateTime  @default(now()) @db.Timestamptz(6)
  lockedBy      String?   @db.VarChar(120)
  lockedUntil   DateTime? @db.Timestamptz(6)
  heartbeatAt   DateTime? @db.Timestamptz(6)
  lastErrorCode String?   @db.VarChar(120)
  idempotencyKey String?  @unique @db.VarChar(160)
  completedAt   DateTime? @db.Timestamptz(6)
  processedAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, runAfter, lockedUntil])
  @@map("outbox_events")
}
