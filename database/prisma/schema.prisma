/// Singleton homepage display settings (docs/45 §3.1).
///
/// The service resolves or creates the one active row. `newArrivalsLimit` is
/// the final configured total, not a request page size; the public API reads it
/// in 24-item cursor batches. The database only imposes the positive,
/// multiple-of-six rule and the PostgreSQL INTEGER range. Do not add an
/// artificial 36/120 business cap here or in DTOs.
model HomepageDisplayConfig {
  id               String   @id @default(uuid()) @db.Uuid
  /// Fixed singleton key. The versioned migration adds a CHECK constraint that
  /// only permits 'default'; together with this UNIQUE index and Prisma upsert,
  /// the database permits at most one configuration row. Prisma cannot express
  /// CHECK constraints in the schema, so the migration is authoritative.
  configKey        String   @unique @default("default") @db.VarChar(40)
  newArrivalsLimit Int      @default(12)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@map("homepage_display_configs")
}

