# Do not put real secrets in this file. Copy to local .env and fill locally.
# Every variable below is read by apps/api, apps/worker (and the Next apps for
# their own public base URLs). Keep this file in sync when adding config.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3002
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3002
# Server-side target used by the Admin Next.js proxy for `/api/v1/*`.
# The browser uses the Admin origin; this host does not need to be public.
ADMIN_API_PROXY_TARGET=http://localhost:3002
# Server-side target used by the Storefront same-origin inquiry proxy.
# The browser never receives this internal API host.
STOREFRONT_API_PROXY_TARGET=http://localhost:3002
# Comma separated list of admin origins allowed to send credentialed requests.
ADMIN_ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=info
LOG_PRETTY=true
TRUST_PROXY=true
SITE_TIMEZONE=UTC

# --- data stores -----------------------------------------------------------
# Production runtime uses the Neon pooled connection. Local development uses
# the compose PostgreSQL instance below.
DATABASE_URL=postgresql://app:app_local_only@localhost:5432/b2b_catalog?schema=public
# Direct Neon connection used only by controlled migration jobs. Leave empty
# locally to reuse DATABASE_URL.
DIRECT_DATABASE_URL=

# --- sessions and login ----------------------------------------------------
# Use a random secret in every environment; never use this placeholder in production.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=b2b_admin_session
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# --- object storage --------------------------------------------------------
# local: files land under STORAGE_LOCAL_ROOT (development/single-node only).
# Relative paths resolve from the repository root, not an app working directory.
# Production API/Worker replicas must use the shared s3/R2 driver instead.
# s3:    S3-compatible storage such as Cloudflare R2. Configure separate public
#        and private buckets; S3_BUCKET remains as a single-bucket local fallback.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300

# --- storefront ------------------------------------------------------------
# Configure in admin after bootstrap; env value may seed the initial setting only.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_MAX_SELECTED_SKUS=20

# --- geo / analytics -------------------------------------------------------
GEOIP_PROVIDER=database
GEOIP_DATABASE_PATH=./.data/geoip/GeoLite2-Country.mmdb
# Salt for hashing visitor session ids; falls back to SESSION_SECRET when empty.
ANALYTICS_SALT=
ANALYTICS_ACTIVE_WINDOW_SECONDS=300
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_EVENTS_PER_MINUTE=120

# --- uploads ---------------------------------------------------------------
# Maximum bytes for one product image. Excel bulk import has its own 300MB XLSX
# limit and uses 8MB request chunks; this value does not cap the whole workbook.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=50000000
IMAGE_DERIVATIVE_WIDTHS=320,640,1280
IMAGE_PROCESSING_TIMEOUT_SECONDS=20
IMAGE_PROCESSING_CONCURRENCY=1
IMAGE_WEBP_QUALITY=82
QUOTE_EXPORT_MAX_PRODUCTS=5000

# --- Excel to PDF (docs/38) -----------------------------------------------
# Disabled by default. Enable only after the Worker image has LibreOffice,
# http and CJK fonts, and enough memory/disk for the configured maximum.
EXCEL_PDF_ENABLED=false
EXCEL_PDF_MAX_UPLOAD_BYTES=209715200
EXCEL_PDF_CHUNK_BYTES=8388608
EXCEL_PDF_MAX_OUTPUT_BYTES=52428800
EXCEL_PDF_MAX_PAGES=200
EXCEL_PDF_TIMEOUT_MS=300000
EXCEL_PDF_RETENTION_DAYS=7
EXCEL_PDF_CONVERTER_PATH=/usr/bin/soffice
EXCEL_PDF_PDFINFO_PATH=/usr/bin/pdfinfo

# --- background jobs -------------------------------------------------------
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=30
TASK_RUNNER_ID=
TASK_LEASE_SECONDS=120
TASK_POLL_INTERVAL_MS=2000
TASK_RETRY_BASE_DELAY_MS=3000
# Worker-only private scratch directory. Mount a disk with at least 2 GiB free
# beyond the source workbook and LibreOffice profile for large conversions.
WORKER_TMP_DIR=./.data/tmp
# --- bootstrap (used only by `pnpm bootstrap:admin`) -----------------------
# Never commit real credentials; the command prints a generated password once.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Shared secret for POST {APP_BASE_URL}/api/revalidate (storefront ISR cache).
# Leave empty to rely on the storefront ISR TTL instead of on-demand invalidation.
REVALIDATE_SECRET=
